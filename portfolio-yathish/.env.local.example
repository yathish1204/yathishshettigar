# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# Admin Credentials (Set secure credentials here in production)
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password

# Authentication Secret
AUTH_SECRET=your-super-secret-key-at-least-32-chars-long

# Email Dispatch Option 1: Gmail SMTP / Custom SMTP (Recommended: Sends to any user directly)
# Generate a 16-character Google App Password at: https://myaccount.google.com/apppasswords
SMTP_USER=yathish120420@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Email Dispatch Option 2: Resend API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# Once domain is verified on resend.com/domains:
RESEND_FROM_EMAIL=Yathish Shettigar <contact@yathishshettigar.site>

# Google reCAPTCHA v2
NEXT_PUBLIC_RE_CAPTCHA_SITE_KEY=your_recaptcha_site_key
RE_CAPTCHA_SECRET_KEY=your_recaptcha_secret_key

